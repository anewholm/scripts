#!/bin/bash
################################
# Deploy a Mondrian (xmondrian + Xavier) OLAP webapp into Tomcat 9: one webapp per
# project warehouse database, served at http://localhost:<port>/<database>/xavier/
#
# Run from a project directory that contains olap/:
#   olap/datasources.xml        XMLA data source. OLAP_PASSWORD is replaced with $ACORN_OLAP_PASSWORD
#   olap/schema/<database>.xml  Mondrian schema (the cubes)
#   olap/<database>.sql         optional idempotent warehouse build; applied by hand, see its header
#   olap/mondrian.properties    optional override of the template's
#
# The webapp is built from this repo's olap/template, an expanded xmondrian with the Acorn
# patches already applied (Xavier ?cube= auto-select, window.xavierApplication).
# Members of the tomcat group deploy without sudo. sudo is only used to install missing
# prerequisites, to change the Tomcat port and, with --proxy, to add an Apache reverse proxy
# (production, where Tomcat is not exposed directly).
################################
[ -f ~/.acorn/credentials ] && source ~/.acorn/credentials
RED="$(tput setaf 1)"
GREEN="$(tput setaf 2)"
YELLOW="$(tput setaf 3)"
NC="$(tput sgr0)"
###############################

error() { echo "${RED}ERROR${NC}: $1"; exit 1; }

script_dir="$(dirname "$(readlink -f "$0")")"
template="$script_dir/olap/template"
webapps=/var/lib/tomcat9/webapps
olap_dir="$(pwd)/olap"

proxy=
positional=()
for arg in "$@"; do
  case "$arg" in
    --proxy) proxy=1 ;;
    -h|--help|help)
      echo "Usage: acorn-setup-olap <database> [<port>] [--proxy]"
      echo
      echo "database:  Warehouse database, also the webapp and schema name. Required"
      echo "port:      Tomcat HTTP port. Default: ${GREEN}8080${NC}"
      echo "--proxy:   Add an Apache reverse proxy /<database> => Tomcat (sudo). For production"
      exit 0
      ;;
    *) positional+=("$arg") ;;
  esac
done
set -- "${positional[@]}"

database=$1
port=${2:-8080}

# The database name becomes a path that rsync --delete writes to, so keep it simple
if [[ ! "$database" =~ ^[a-z][a-z0-9_]*$ ]]; then error "Database name [$database] required: lowercase letters, digits and underscores"; fi
webapp="$webapps/$database"
echo "Using settings: Database:${YELLOW}$database${NC}, Port:${YELLOW}$port${NC}, Webapp:${YELLOW}$webapp${NC}"

# ------------------------------- Project files
if [ ! -f "$olap_dir/datasources.xml" ];        then error "$olap_dir/datasources.xml not found. Run this from the project directory"; fi
if [ ! -f "$olap_dir/schema/$database.xml" ];   then error "$olap_dir/schema/$database.xml not found"; fi
if [ ! -d "$template/WEB-INF" ];                then error "Webapp template $template not found"; fi
if grep -q OLAP_PASSWORD "$olap_dir/datasources.xml" && [ -z "$ACORN_OLAP_PASSWORD" ]; then
  error "ACORN_OLAP_PASSWORD is not set. Add it to ~/.acorn/credentials (see acorn-credentials.example)"
fi

# ------------------------------- Pre-requisites (sudo only when missing)
if [ ! -d /var/lib/tomcat9 ]; then
  # tomcat9 brings in a Java runtime. The webapp bundles its own PostgreSQL JDBC driver
  ubuntu_version=`lsb_release -rs | cut -d '.' -f 1`
  if [ "$ubuntu_version" != 22 ]; then
    echo "${YELLOW}WARNING${NC}: Installing TomCat 9 on Ubuntu $ubuntu_version with jammy main universe"
    sudo add-apt-repository -y -s "deb http://archive.ubuntu.com/ubuntu/ jammy main universe"
  else
    echo "${GREEN}INFO${NC}: Installing TomCat 9 on Ubuntu $ubuntu_version"
  fi
  sudo apt-get -y install tomcat9 || error "Failed to install Tomcat 9"
fi

if ! id -nG | grep -qw tomcat; then
  sudo usermod -a -G tomcat "$USER" || error "Failed to add $USER to the tomcat group"
  echo "${YELLOW}WARNING${NC}: $USER has been added to the ${YELLOW}tomcat${NC} group. Log out and in again, then re-run $0"
  exit 0
fi

if ! grep -q "<Connector port=\"$port\"" /etc/tomcat9/server.xml; then
  echo "${GREEN}INFO${NC}: Setting TomCat 9 HTTP port to $port"
  sudo sed -i "0,/<Connector port=\"[0-9]*\"/s//<Connector port=\"$port\"/" /etc/tomcat9/server.xml || error "Failed to set the Tomcat port"
  sudo systemctl restart tomcat9
fi

# ------------------------------- Webapp
# Sync the template, keeping only this project's datasource and schemas.
# No owner, group, permission or directory-time preservation: files may belong to
# other tomcat group members, and only their owners may change those attributes.
echo "${GREEN}INFO${NC}: Syncing webapp template into $webapp"
rsync -rltO --delete --chmod=Dg+rwxs,Fg+rw \
  --exclude=/WEB-INF/datasources.xml --exclude=/WEB-INF/schema/ \
  "$template/" "$webapp/" || error "Failed to sync $template to $webapp"

echo "${GREEN}INFO${NC}: Installing project schema and datasource"
rsync -rltO --delete --chmod=Dg+rwxs,Fg+rw "$olap_dir/schema/" "$webapp/WEB-INF/schema/" || error "Failed to copy schemas"
perl -pe 's/OLAP_PASSWORD/$ENV{ACORN_OLAP_PASSWORD}/g' "$olap_dir/datasources.xml" > "$webapp/WEB-INF/datasources.xml" || error "Failed to write datasources.xml"
if [ -f "$olap_dir/mondrian.properties" ]; then cp "$olap_dir/mondrian.properties" "$webapp/WEB-INF/classes/"; fi

# Tomcat reads the webapp through the tomcat group
find "$webapp" -user "$(id -un)" ! -group tomcat -exec chgrp tomcat {} +
# datasources.xml holds the database password: group only, when we own it
if [ -O "$webapp/WEB-INF/datasources.xml" ]; then chmod 660 "$webapp/WEB-INF/datasources.xml"; fi

# Touching web.xml makes Tomcat (autoDeploy) redeploy, which also flushes Mondrian's cache
touch "$webapp/WEB-INF/web.xml"

# ------------------------------- Apache reverse proxy (production)
if [ -n "$proxy" ]; then
  conf="tomcat-$database"
  echo "${GREEN}INFO${NC}: Proxying Apache /$database => Tomcat :$port via ${YELLOW}/etc/apache2/conf-available/$conf.conf${NC}"
  printf 'ProxyPass        /%s http://localhost:%s/%s\nProxyPassReverse /%s http://localhost:%s/%s\n' \
    "$database" "$port" "$database" "$database" "$port" "$database" \
    | sudo tee "/etc/apache2/conf-available/$conf.conf" > /dev/null
  sudo a2enmod -q proxy proxy_http
  sudo a2enconf -q "$conf"
  sudo apache2ctl configtest && sudo systemctl reload apache2
fi

# ------------------------------- Wait for Tomcat to (re)deploy
url="http://localhost:$port/$database/xavier/index.html"
for i in $(seq 30); do
  if [ "$(curl -s -o /dev/null -w '%{http_code}' "$url")" = 200 ]; then break; fi
  sleep 1
done
if [ "$(curl -s -o /dev/null -w '%{http_code}' "$url")" != 200 ]; then
  error "$url is not responding. See /var/log/tomcat9/catalina.$(date +%Y-%m-%d).log"
fi

if [ -f "$olap_dir/$database.sql" ]; then
  echo "${GREEN}INFO${NC}: Warehouse build in ${YELLOW}$olap_dir/$database.sql${NC}: apply and refresh it as its header describes"
fi
echo "Now go to ${YELLOW}$url${NC}"
