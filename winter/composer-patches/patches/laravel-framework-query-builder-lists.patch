+    /**
+     * Winter's lists(), for connections that are plain Laravel ones.
+     *
+     * DBAuth makes the pgsql connection with Illuminate's ConnectionFactory, not Winter's, so
+     * Db::table() returns this builder rather than Winter's QueryBuilder. Winter core still calls
+     * Db::table(...)->lists() (VersionManager, PluginManager), which fails without this.
+     */
+    public function lists($column, $key = null)
+    {
+        return $this->pluck($column, $key)->all();
+    }
